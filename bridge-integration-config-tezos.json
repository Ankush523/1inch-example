{
  "name": "ETH<>Tezos Cross-Chain Bridge Integration",
  "description": "Configuration for Ethereum to Tezos atomic swaps using 1inch Limit Order Protocol",
  "version": "1.0.0",
  "networks": {
    "ethereum": {
      "name": "Ethereum Sepolia Testnet",
      "chainId": 11155111,
      "rpcUrl": "https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY",
      "currency": "ETH",
      "decimals": 18,
      "contracts": {
        "factory": "0x218fbA453A0d51D86a8deA1d359D965CC4873A5c",
        "limitOrderProtocol": "0x11431eE90fE1414c314026d4600A0aC1D85F5F98",
        "tezosResolver": "TO_BE_DEPLOYED"
      }
    },
    "tezos": {
      "name": "Tezos Ghostnet",
      "chainId": "ghostnet",
      "rpcUrl": "https://ghostnet.tezos.marigold.dev",
      "currency": "XTZ",
      "decimals": 6,
      "contracts": {
        "escrow": "TO_BE_DEPLOYED",
        "resolver": "TO_BE_DEPLOYED"
      }
    }
  },
  "bridge": {
    "type": "atomic-swap",
    "timelock": {
      "ethereum": 7200,
      "tezos": 86400
    },
    "fees": {
      "network": "0.001 ETH",
      "safety_deposit": "0.01 ETH"
    },
    "limits": {
      "min_eth": "0.001",
      "max_eth": "10",
      "min_xtz": "1",
      "max_xtz": "1000"
    }
  },
  "deployment": {
    "steps": [
      {
        "step": 1,
        "description": "Deploy TezosEthereumResolver on Ethereum",
        "command": "forge script scripts/DeployTezosEthereumResolver.s.sol --rpc-url $ETH_TESTNET_RPC --private-key $DEPLOYER_PRIVATE_KEY --broadcast"
      },
      {
        "step": 2,
        "description": "Deploy Tezos escrow contract",
        "command": "tezos-client originate contract tezos_escrow transferring 0 from alice running tezos_escrow.tz"
      },
      {
        "step": 3,
        "description": "Deploy Tezos resolver contract",
        "command": "tezos-client originate contract tezos_resolver transferring 0 from alice running tezos_resolver.tz"
      },
      {
        "step": 4,
        "description": "Update configuration with deployed addresses",
        "command": "Update .env file with deployed contract addresses"
      }
    ]
  },
  "testing": {
    "scripts": [
      {
        "name": "ETH to Tezos Demo",
        "command": "npx ts-node src/eth-to-tezos-demo.ts",
        "description": "Demonstrates initiating a swap from Ethereum to Tezos"
      },
      {
        "name": "Tezos to ETH Demo",
        "command": "npx ts-node src/tezos-to-eth-demo.ts",
        "description": "Demonstrates initiating a swap from Tezos to Ethereum"
      },
      {
        "name": "Complete Swap Demo",
        "command": "npx ts-node src/complete-tezos-swap-demo.ts",
        "description": "Demonstrates completing a cross-chain swap"
      }
    ]
  },
  "requirements": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0",
    "tezos-client": ">=18.0.0",
    "forge": ">=0.2.0"
  }
}
