{
  "name": "cross-chain-resolver-example",
  "version": "1.0.0",
  "description": "Example of 1inch cross chain resolver",
  "scripts": {
    "test": "forge build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:bsc" : "forge build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/main.spec.ts",
    "test:aptos": "forge build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/ethereum-aptos-bridge.spec.ts",
    "test:cardano": "forge build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/ethereum-cardano-bridge.spec.ts",
    "lint": "eslint  \"tests/**/*.ts\"",
    "build": "forge build && cd sdk && npm run build && cd ../demo && npm run build",
    "build:contracts": "forge build",
    "build:aptos": "cd aptos-contracts && aptos move compile",
    "build:cardano": "cd cardano-contracts && cabal build",
    "build:sdk": "cd sdk && npm run build",
    "build:demo": "cd demo && npm run build",
    "deploy:ethereum": "forge script scripts/DeployAptosEthereumResolver.s.sol:DeployAptosEthereumResolver --broadcast",
    "deploy:cardano": "forge script scripts/DeployCardanoEthereumResolver.s.sol:DeployCardanoEthereumResolver --broadcast",
    "deploy:aptos": "./scripts/deploy-aptos.sh",
    "deploy:cardano-contracts": "./scripts/deploy-cardano.sh",
    "deploy:all": "./scripts/deploy-all.sh",
    "deploy-and-swap": "ts-node --transpile-only scripts/deploy-and-swap.ts",
    "demo:eth-to-aptos": "cd demo && npm run demo:eth-to-aptos",
    "demo:aptos-to-eth": "cd demo && npm run demo:aptos-to-eth",
    "demo:complete-swap": "cd demo && npm run demo:complete-swap",
    "demo:eth-to-cardano": "cd demo && npm run demo:eth-to-cardano",
    "demo:cardano-to-eth": "cd demo && npm run demo:cardano-to-eth",
    "demo:complete-cardano-swap": "cd demo && npm run demo:complete-cardano-swap"
  },
  "devDependencies": {
    "@1inch/eslint-config": "^v3.0.7",
    "@1inch/tsconfig": "1.0.7",
    "@eslint/compat": "1.1.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.10.0",
    "@jest/globals": "29.7.0",
    "@swc/core": "1.5.25",
    "@swc/jest": "0.2.36",
    "@types/jest": "29.5.12",
    "@types/node": "^22.16.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "~9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-n": "^17.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "29.7.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.5.2",
    "zod": "3.23.8"
  },
  "author": "1inch",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.5.1"
  },
  "dependencies": {
    "@1inch/byte-utils": "2.6.0",
    "@1inch/cross-chain-sdk": "v0.1.15-rc.0",
    "dotenv": "16.4.5",
    "ethers": "6.13.2",
    "prool": "0.0.24"
  }
}
